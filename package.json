{
  "name": "tradelog",
  "version": "1.0.0",
  "description": "Personal Trading Journal — TradingView CSV importer & analytics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.tradelog.app",
    "productName": "TradeLog",
    "directories": { "output": "dist" },
    "mac": { "category": "public.app-category.finance", "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
